{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": false
    },
    {
      "name": "preview-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview"
      ],
      "port": 4173
    },
    {
      "name": "rabbit-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5175",
        "--directory",
        "assets/pets/rabbit/living-pet"
      ],
      "port": 5175
    },
    {
      "name": "rabbit-gummy",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8099",
        "--directory",
        "assets/pets/rabbit/retro/gummy"
      ],
      "port": 8099
    }
  ]
}
